{
  "name": "crudetrust",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bsc": "hardhat run scripts/deploy.cjs --network bsc",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.cjs --network bscTestnet",
    "upgrade:testnet": "hardhat run scripts/upgrade-testnet.cjs --network bscTestnet",
    "bot:dynamic:settle": "hardhat run scripts/bot-daily-dynamic-settlement.cjs",
    "bot:dynamic:settle:testnet": "hardhat run scripts/bot-daily-dynamic-settlement.cjs --network bscTestnet",
    "bot:dynamic:settle:bsc": "hardhat run scripts/bot-daily-dynamic-settlement.cjs --network bsc",
    "deploy:pages": "wrangler pages deploy dist --project-name crudetrust",
    "deploy:pages:main": "npm run build && wrangler pages deploy dist --project-name crudetrust --branch main",
    "deploy:pages:test": "npm run build && wrangler pages deploy dist --project-name crudetrust --branch test"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.100.9",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.48.8",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "hardhat": "^2.28.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.52.0"
  }
}
