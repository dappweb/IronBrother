{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ironbrother-keeper-testnet",
  "main": "workers/keeper.js",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CHAIN_ID": "97",
    "BSC_RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
    "IRONBROTHER_PROXY": "0x5D8d8Fe47EcA5B2812194e3cD149CAAeb315e72E",
    "DYNAMIC_SETTLEMENT_BATCH_SIZE": "50",
    "DYNAMIC_SETTLEMENT_MAX_BATCHES": "10000"
  }
}
